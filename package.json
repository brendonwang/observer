{
  "name": "@brendonwang/observer",
  "version": "0.2.0-beta.1",
  "description": "Private, self-hosted monitoring for AI agents and developer activity",
  "type": "module",
  "bin": {
    "observer": "./bin/observer.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brendonwang/observer.git"
  },
  "bugs": {
    "url": "https://github.com/brendonwang/observer/issues"
  },
  "homepage": "https://github.com/brendonwang/observer#readme",
  "keywords": [
    "codex",
    "claude-code",
    "pi",
    "developer-tools",
    "monitoring",
    "cloudflare",
    "self-hosted"
  ],
  "files": [
    "bin/",
    "agent.py",
    "service_adapter.py",
    "worker.js",
    "schema.sql",
    "README.md",
    "LICENSE",
    "docs/DESIGN.md"
  ],
  "scripts": {
    "build": "python3 build_worker.py",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:agent": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:build": "python3 build_worker.py --check",
    "prepack": "npm run test:build"
  },
  "publishConfig": {
    "access": "public"
  }
}
